# ==============================================================================
# GitGavel Local Environment Configuration
# Copy this file to '.env' and fill in your keys:
# cp .env.example .env
# ==============================================================================

# 1. Generative LLM API Key (Gemini)
# Get a key from Google AI Studio: https://aistudio.google.com/
AI_API_KEY=your_gemini_api_key_here

# 2. TypeSafe Jev API Key (System 1 Decision Engine)
# Get a key from TypeSafe AI: https://typesafe.ai/
JEV_API_KEY=your_jev_api_key_here

# 3. GitHub Personal Access Token
# Required scopes: 'repo' and 'project' (or 'issues:write', 'repository-projects:write')
GH_TOKEN=your_github_token_here

